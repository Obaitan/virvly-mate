---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import StepCard from '../components/StepCard.astro';
import WhereCard from '../components/WhereCard.astro';
---

<Layout title="VirvlyMate — The photographs you take already have buyers.">
  <!-- Scrollable page container -->
  <div class="relative min-h-screen bg-brand-paper select-none font-body text-brand-charcoal overflow-x-hidden">
    
    <!-- HEADER -->
    <Header activePage="home" />

    <!-- HERO SECTION -->
    <section class="relative min-h-[95vh] flex items-center justify-center pt-24 pb-16 md:pt-32 md:pb-24 text-white overflow-hidden">
      <!-- High performance background image (LCP candidate) -->
      <img 
        src="/images/hero-photographer.jpg" 
        alt="Photographer outdoor landscape hero banner" 
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <!-- Dark scrim overlay for readability -->
      <!-- <div class="absolute inset-0 bg-brand-blue-deep/75 mix-blend-multiply z-10"></div> -->
      <div class="absolute inset-0 bg-gradient-to-b from-brand-blue-deep/40 via-brand-blue-deep/60 to-brand-blue-deep/95 z-10"></div>

      <!-- Wrap Content -->
      <div class="wrap relative z-20 flex flex-col items-start text-left max-w-3xl px-4 mt-8 md:mt-12">
        <h1 class="font-heading font-extrabold text-white text-[44px] md:text-7xl leading-tight sm:leading-[1.1] tracking-tight mb-4 sm:mb-6 max-w-3xl">
          The photographs you take already have buyers.
        </h1>
        <p class="font-body text-xl leading-relaxed sm:leading-[1.6] text-white max-w-xl mb-8 sm:mb-10">
          Most of them never find them. <span class="font-bold text-brand-orange">VirvlyMate</span> lets people find themselves in your photographs and buy the ones they want.
        </p>

        <!-- Dual CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-6 sm:mb-8 w-full sm:w-auto">
          <Button 
            href="https://app.virvlymate.com" 
            variant="primary" 
            class="w-auto text-[15px] sm:text-base px-8 py-3.5 sm:py-4 shadow-lg shadow-brand-orange/20"
          >
            Try VirvlyMate <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
          </Button>
          <Button 
            href="/contact" 
            variant="ghost" 
            class="w-auto text-[15px] sm:text-base px-8 py-3.5 sm:py-4"
          >
            Contact Us
          </Button>
        </div>

        <p class="text-base sm:text-lg text-white/90">
          Someone photographed you? 
          <a href="/clients" class="font-semibold text-brand-orange hover:underline focus:outline-none block sm:inline mt-1 sm:mt-0">
            Find your photos &rarr;
          </a>
        </p>
      </div>

      <!-- Scroll hint -->
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 text-[12px] font-heading font-semibold tracking-widest uppercase text-white/60">
        <span class="w-[1.5px] h-10 bg-gradient-to-b from-brand-orange to-transparent animate-bounce"></span>
        How it works
      </div>
    </section>

    <!-- HOW IT WORKS SECTION -->
    <section class="py-20 md:py-28 bg-white" id="how">
      <div class="wrap">
        <!-- Section Header -->
        <div class="mb-16 md:mb-20 md:text-center">
          <span class="font-heading font-bold text-xs tracking-widest text-brand-blue uppercase block mb-4">
            How VirvlyMate works
          </span>
          <h2 class="font-heading font-extrabold text-[32px] sm:text-[40px] md:text-[44px] leading-tight text-brand-charcoal">
            Five steps. Nothing to chase.
          </h2>
        </div>

        <!-- 5 Steps Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-y-10 md:gap-y-12 gap-x-7 xl:gap-x-[18px]">
          <StepCard 
            num="1" 
            tag="PHOTOGRAPH" 
            title="Photograph the moments." 
            desc="Work the way you already do, with nothing new to learn." 
            image="/images/step-1.jpg"
          />
          <StepCard 
            num="2" 
            tag="CONNECT" 
            title="Give people a way to find photos." 
            desc="A code or link means you don't have to chase them down." 
            image="/images/step-2.jpg"
          />
          <StepCard 
            num="3" 
            tag="UPLOAD" 
            title="Add your photos to VirvlyMate." 
            desc="Upload from your phone or camera in seconds." 
            image="/images/step-3.jpg"
          />
          <StepCard 
            num="4" 
            tag="FIND & BUY" 
            title="They find their photos and pay." 
            desc="A selfie shows only the photographs they're in." 
            image="/images/step-4.jpg"
          />
          <StepCard 
            num="5" 
            tag="GET PAID" 
            title="Get paid automatically." 
            desc="Your fee lands in your account. Nothing to invoice." 
            image="/images/step-5.jpg"
          />
        </div>
      </div>
    </section>

    <!-- WHERE IT WORKS SECTION -->
    <section class="py-20 md:py-24 bg-[#f6f7f8]">
      <div class="wrap">
        <!-- Section Header -->
        <div class="max-w-2xl mb-10">
          <span class="font-heading font-bold text-xs tracking-widest text-brand-blue uppercase block mb-4">
            Where it works
          </span>
          <h2 class="font-heading font-extrabold text-3xl md:text-4xl leading-tight text-brand-charcoal max-w-xl">
            Wherever you're photographing people you don't already know.
          </h2>
        </div>

        <!-- Where Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 gap-y-5">
          <WhereCard title="Beaches & resorts" image="/images/where-1.jpg" />
          <WhereCard title="Landmarks & attractions" image="/images/where-2.jpg" />
          <WhereCard title="Parks & outdoor spaces" image="/images/where-3.jpg" />
          <WhereCard title="Weddings & live events" image="/images/where-4.jpg" />
        </div>
      </div>
    </section>

    <!-- GETTING PAID SECTION -->
    <section class="py-20 md:py-24 bg-white">
      <div class="wrap">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 xl:gap-24 items-center">
          <!-- Copy Column -->
          <div class="lg:col-span-6 space-y-4">
            <span class="font-heading font-bold text-xs tracking-widest text-brand-blue uppercase block">
              Getting paid
            </span>
            <h2 class="font-heading font-extrabold text-3xl md:text-4xl leading-tight text-brand-charcoal">
              You set the price. <br />You're paid when it sells.
            </h2>
            <p class="font-body text-[15.5px] lg:max-w-[420px] leading-relaxed text-brand-grey-1">
              Set your price and let VirvlyMate handle the transaction. Your fee is paid directly to your account, with no invoices to send or payments to chase.
            </p>
          </div>

          <!-- Terms List Column -->
          <div class="lg:col-span-6">
            <ul class="divide-y divide-black/10 border-t border-b border-black/10">
              <li class="py-4 flex justify-between gap-4">
                <span class="font-body text-[14.5px] text-brand-grey-1">Set your prices</span>
                <span class="font-heading font-bold text-[14.5px] text-brand-charcoal text-right">You do</span>
              </li>
              <li class="py-4 flex justify-between gap-4">
               <span class="font-body text-[14.5px] text-brand-grey-1">Customer payments</span>
               <span class="font-heading font-bold text-[14.5px] text-brand-charcoal text-right">Handled through VirvlyMate</span>
              </li>
              <li class="py-4 flex justify-between gap-4">
                <span class="font-body text-[14.5px] text-brand-grey-1">Invoicing customers</span>
                <span class="font-heading font-bold text-[14.5px] text-brand-charcoal text-right">Not needed</span>
              </li>
              <li class="py-4 flex justify-between gap-4">
                <span class="font-body text-[14.5px] text-brand-grey-1">Sending photos afterwards</span>
                <span class="font-heading font-bold text-[14.5px] text-brand-charcoal text-right">Not needed</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA SECTION -->
    <section class="relative py-28 md:py-36 text-white text-center overflow-hidden">
      <!-- High performance background image -->
      <img 
        src="/images/cta-background.jpg" 
        alt="Ready to get started camera background" 
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <!-- Dark scrim overlay for readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-blue-deep/95 via-brand-blue-deep/75 to-brand-blue-deep/50 z-10"></div>

      <!-- Wrap Content -->
      <div class="wrap relative z-20 flex flex-col items-center max-w-2xl px-4">
        <h2 class="font-heading font-extrabold text-white text-[36px] md:text-[48px] leading-tight tracking-tight mb-4">
          Ready to get started?
        </h2>
        <p class="font-body text-base md:text-lg leading-relaxed text-white max-w-md mb-8">
          Set up in minutes and upload your first photographs today.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8 w-full sm:w-auto">
          <Button 
            href="https://app.virvlymate.com" 
            variant="primary" 
            class="text-[14.5px] px-8 py-3.5 shadow-lg shadow-brand-orange/20 w-full sm:w-auto"
          >
            Try VirvlyMate <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
          </Button>
          <Button 
            href="/contact" 
            variant="ghost" 
            class="text-[14.5px] px-8 py-3.5 w-full sm:w-auto"
          >
            Get in touch
          </Button>
        </div>

        <p class="text-base text-white/90">
          Here for your own photos instead? 
          <a href="/clients" class="font-semibold text-brand-orange hover:underline focus:outline-none ml-1">
            Find my photos &rarr;
          </a>
        </p>
      </div>
    </section>

    <!-- FOOTER -->
    <Footer />

  </div>
</Layout>
