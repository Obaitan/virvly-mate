---
import Button from './Button.astro';
---

<section id="photo-matcher-section" class="py-16 md:py-20 bg-gray-50 relative z-20 -mt-8 rounded-t-3xl">
  <div id="matcher-container" class="wrap max-w-xl transition-all duration-500 ease-in-out">
    
    <!-- Interactive Form Card -->
    <div class="bg-brand-paper border border-black/5 rounded-2xl p-6 sm:p-8 shadow-sm">
      
      <form id="matcher-form" class="space-y-6">
        <div class="text-center max-w-lg mx-auto mb-6">
          <h2 class="font-heading font-extrabold text-[22px] sm:text-[24px] text-brand-charcoal mb-2">
            Photo Matcher
          </h2>
          <p class="font-body text-[13.5px] text-brand-grey-1">
            Upload a selfie and enter your photographer code to discover your photos.
          </p>
        </div>

        <!-- Drag and Drop / Upload zone -->
        <div>
          <label class="block font-heading font-bold text-[13px] uppercase tracking-wider text-brand-charcoal mb-2.5">
            1. Upload selfie or portrait
          </label>
          <div 
            id="drop-zone" 
            class="relative border-2 border-dashed border-black/15 hover:border-brand-blue/50 rounded-xl py-10 px-8 flex flex-col items-center justify-center bg-white cursor-pointer transition-colors group min-h-[220px]"
          >
            <!-- Input element (hidden) -->
            <input 
              type="file" 
              id="file-input" 
              accept="image/*" 
              class="absolute inset-0 opacity-0 cursor-pointer" 
              required
            />
            
            <!-- SVG Camera Icon -->
            <svg 
              id="upload-icon"
              class="w-10 h-10 text-brand-grey-2 group-hover:text-brand-blue transition-colors mb-3" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="1.8" 
              stroke-linecap="round" 
              stroke-linejoin="round"
            >
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>

            <p id="upload-text" class="font-heading font-semibold text-[14px] text-brand-charcoal mb-1 text-center group-hover:text-brand-blue transition-colors">
              Click or drag photo here
            </p>
            <p id="upload-subtext" class="font-body text-[11.5px] text-brand-grey-2 text-center">
              Supports JPEG, PNG up to 5MB
            </p>

            <!-- Selected preview container -->
            <div id="preview-container" class="hidden absolute inset-0 bg-[#fafafb] rounded-xl overflow-hidden p-2">
              <div class="relative w-full h-full rounded-lg overflow-hidden flex items-center justify-center">
                <img id="preview-image" src="" alt="Selfie preview" class="w-full h-full object-contain" />
                <!-- Change button overlay -->
                <div id="change-photo-overlay" class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity cursor-pointer">
                  <span class="text-white text-[12.5px] font-semibold bg-brand-charcoal/80 px-3 py-1.5 rounded-md backdrop-blur-sm">
                    Change Photo
                  </span>
                </div>
              </div>
            </div>
          </div>
          <p id="size-error-msg" class="hidden text-[12px] text-red-500 font-semibold mt-2 items-center gap-1">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Image size exceeds 5MB limit. Please choose a smaller file.
          </p>
        </div>

        <!-- Photographer code input (Compulsory) -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="photo-code" class="block font-heading font-bold text-[13px] uppercase tracking-wider text-brand-charcoal">
              2. Photographer Code
            </label>
            <span class="text-[11px] font-heading font-bold text-brand-orange uppercase tracking-wider">Required</span>
          </div>
          <input 
            type="text" 
            id="photo-code" 
            placeholder="e.g. SUMMER26" 
            maxlength="12"
            required
            class="w-full px-4 py-3 rounded-xl border border-black/15 focus:border-brand-blue focus:ring-1 focus:ring-brand-blue/35 bg-white text-[14.5px] font-heading font-semibold text-brand-charcoal uppercase tracking-wider placeholder:normal-case placeholder:font-normal placeholder:tracking-normal focus:outline-none transition-all"
          />
          <p class="text-[11px] text-brand-grey-2 mt-1.5 leading-relaxed">
            Tip: Enter code <code class="font-mono font-bold text-brand-orange bg-brand-orange/5 px-1 py-0.5 rounded">NOMATCH</code> to test the no-matches state.
          </p>
        </div>

        <!-- Submit button wrapper -->
        <button 
          type="submit" 
          class="w-full bg-brand-orange hover:bg-brand-orange-light text-white font-heading font-bold text-[14px] tracking-wide uppercase py-4 px-6 rounded-xl shadow-md transition-all duration-300 hover:scale-[1.01] hover:shadow-lg focus:outline-none flex items-center justify-center gap-2"
        >
          Find my photos
        </button>
      </form>

      <!-- Simulated matching/scanning flow layout -->
      <div id="scanning-state" class="hidden py-8 flex-col items-center justify-center">
        <div class="relative w-20 h-20 mb-5">
          <!-- Animated outer spinning ring -->
          <div class="absolute inset-0 rounded-full border-4 border-brand-blue/20 border-t-brand-blue animate-spin"></div>
          <!-- Inner pulse scanner -->
          <div class="absolute inset-3 rounded-full bg-brand-orange/10 animate-ping"></div>
        </div>
        <h3 class="font-heading font-bold text-[16px] text-brand-charcoal mb-1">Scanning Face...</h3>
        <p class="font-body text-[12.5px] text-brand-grey-1 text-center">Comparing features with VirvlyMate matches</p>
      </div>

      <!-- Simulated results container -->
      <div id="results-state" class="hidden">
        
        <!-- CASE 1: MATCHES FOUND (6 IN A ROW GRID) -->
        <div id="matches-container" class="hidden">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-black/5 pb-4 mb-6 gap-3">
            <div class="text-left">
              <h3 class="font-heading font-extrabold text-[18px] text-brand-charcoal">Matched Photos</h3>
              <p class="font-body text-[13px] text-brand-grey-1">Select the photos you want to download</p>
            </div>
            <!-- Dynamic Select All Button -->
            <button 
              type="button" 
              id="select-all-btn" 
              class="text-[13.5px] font-heading font-bold text-brand-orange hover:text-brand-orange-hover focus:outline-none transition-colors flex items-center gap-2 shrink-0 self-start sm:self-center"
            >
              <span class="w-4 h-4 rounded border border-brand-orange/40 flex items-center justify-center bg-white text-white text-[10px] select-none font-bold" id="select-all-checkbox"></span>
              Select All (6)
            </button>
          </div>

          <!-- Gorgeous 6 per row photo strip -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 mb-8">
            <!-- Photo Item 1 -->
            <div class="photo-card group relative aspect-[3/4] rounded-xl overflow-hidden cursor-pointer border border-black/5 shadow-sm transition-all hover:scale-[1.02] ring-brand-orange" data-id="1">
              <img src="/images/step-1.jpg" alt="Match 1" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors"></div>
              <div class="absolute top-2.5 right-2.5 w-5 h-5 rounded-md border-2 border-white bg-black/40 flex items-center justify-center text-white transition-all select-none checkbox-indicator">
                <svg class="w-3.5 h-3.5 opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <!-- Photo Item 2 -->
            <div class="photo-card group relative aspect-[3/4] rounded-xl overflow-hidden cursor-pointer border border-black/5 shadow-sm transition-all hover:scale-[1.02] ring-brand-orange" data-id="2">
              <img src="/images/step-2.jpg" alt="Match 2" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors"></div>
              <div class="absolute top-2.5 right-2.5 w-5 h-5 rounded-md border-2 border-white bg-black/40 flex items-center justify-center text-white transition-all select-none checkbox-indicator">
                <svg class="w-3.5 h-3.5 opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <!-- Photo Item 3 -->
            <div class="photo-card group relative aspect-[3/4] rounded-xl overflow-hidden cursor-pointer border border-black/5 shadow-sm transition-all hover:scale-[1.02] ring-brand-orange" data-id="3">
              <img src="/images/step-3.jpg" alt="Match 3" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors"></div>
              <div class="absolute top-2.5 right-2.5 w-5 h-5 rounded-md border-2 border-white bg-black/40 flex items-center justify-center text-white transition-all select-none checkbox-indicator">
                <svg class="w-3.5 h-3.5 opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <!-- Photo Item 4 -->
            <div class="photo-card group relative aspect-[3/4] rounded-xl overflow-hidden cursor-pointer border border-black/5 shadow-sm transition-all hover:scale-[1.02] ring-brand-orange" data-id="4">
              <img src="/images/step-4.jpg" alt="Match 4" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors"></div>
              <div class="absolute top-2.5 right-2.5 w-5 h-5 rounded-md border-2 border-white bg-black/40 flex items-center justify-center text-white transition-all select-none checkbox-indicator">
                <svg class="w-3.5 h-3.5 opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <!-- Photo Item 5 -->
            <div class="photo-card group relative aspect-[3/4] rounded-xl overflow-hidden cursor-pointer border border-black/5 shadow-sm transition-all hover:scale-[1.02] ring-brand-orange" data-id="5">
              <img src="/images/step-5.jpg" alt="Match 5" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors"></div>
              <div class="absolute top-2.5 right-2.5 w-5 h-5 rounded-md border-2 border-white bg-black/40 flex items-center justify-center text-white transition-all select-none checkbox-indicator">
                <svg class="w-3.5 h-3.5 opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <!-- Photo Item 6 -->
            <div class="photo-card group relative aspect-[3/4] rounded-xl overflow-hidden cursor-pointer border border-black/5 shadow-sm transition-all hover:scale-[1.02] ring-brand-orange" data-id="6">
              <img src="/images/client-hero.jpg" alt="Match 6" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors"></div>
              <div class="absolute top-2.5 right-2.5 w-5 h-5 rounded-md border-2 border-white bg-black/40 flex items-center justify-center text-white transition-all select-none checkbox-indicator">
                <svg class="w-3.5 h-3.5 opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Action buttons underneath -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <button 
              id="download-selected-btn" 
              class="w-full sm:w-auto bg-brand-orange hover:bg-brand-orange-light text-white font-heading font-bold text-[14px] tracking-wide uppercase py-3.5 px-8 rounded-full shadow-md transition-all duration-300 hover:scale-[1.01] hover:shadow-lg focus:outline-none flex items-center justify-center gap-2"
            >
              Download 6 Images
            </button>
            <button 
              type="button"
              id="reset-matches-btn" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 font-semibold text-[14px] px-8 py-3.5 rounded-full cursor-pointer transition-all duration-300 ease-in-out shadow-md hover:shadow-lg bg-brand-blue-deep hover:bg-brand-blue-deep/90 text-white border border-black/10 uppercase"
            >
              Reset Search
            </button>
          </div>
        </div>

        <!-- CASE 2: NO MATCHES FOUND -->
        <div id="no-matches-container" class="hidden text-center py-6">
          <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="font-heading font-extrabold text-[22px] text-brand-charcoal mb-3">No Matches Found</h3>
          <p class="font-body text-[14.5px] text-brand-grey-1 max-w-md mx-auto mb-8 leading-relaxed">
            We couldn't find any photos matching your uploaded selfie under code <strong id="searched-code-label" class="uppercase"></strong>. Please make sure your face is clearly visible and verify your photographer code.
          </p>
          <button 
            type="button"
            id="reset-no-matches-btn" 
            class="flex items-center justify-center gap-2 font-semibold text-[14px] px-8 py-3.5 rounded-full cursor-pointer transition-all duration-300 ease-in-out shadow-md hover:shadow-lg bg-brand-blue-deep hover:bg-brand-blue-deep/90 text-white mx-auto uppercase"
          >
            Try Another Search
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Handle client-side interactive form and scanning behavior inside Component
  const form = document.getElementById('matcher-form') as HTMLFormElement | null;
  const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
  const previewContainer = document.getElementById('preview-container') as HTMLDivElement | null;
  const previewImage = document.getElementById('preview-image') as HTMLImageElement | null;
  const dropZone = document.getElementById('drop-zone') as HTMLDivElement | null;
  const photoCodeInput = document.getElementById('photo-code') as HTMLInputElement | null;
  const changePhotoOverlay = document.getElementById('change-photo-overlay') as HTMLDivElement | null;
  const sizeErrorMsg = document.getElementById('size-error-msg') as HTMLParagraphElement | null;

  const matcherContainer = document.getElementById('matcher-container') as HTMLDivElement | null;
  const scanningState = document.getElementById('scanning-state') as HTMLDivElement | null;
  const resultsState = document.getElementById('results-state') as HTMLDivElement | null;
  
  // Results Containers
  const matchesContainer = document.getElementById('matches-container') as HTMLDivElement | null;
  const noMatchesContainer = document.getElementById('no-matches-container') as HTMLDivElement | null;
  const searchedCodeLabel = document.getElementById('searched-code-label') as HTMLElement | null;

  // Buttons
  const selectAllBtn = document.getElementById('select-all-btn') as HTMLButtonElement | null;
  const selectAllCheckbox = document.getElementById('select-all-checkbox') as HTMLElement | null;
  const downloadSelectedBtn = document.getElementById('download-selected-btn') as HTMLButtonElement | null;
  const resetMatchesBtn = document.getElementById('reset-matches-btn') as HTMLButtonElement | null;
  const resetNoMatchesBtn = document.getElementById('reset-no-matches-btn') as HTMLButtonElement | null;

  // Photo Cards
  const photoCards = document.querySelectorAll('.photo-card') as NodeListOf<HTMLDivElement>;

  // Selection state (Default: pre-select all 6 images)
  let selectedIds = new Set<string>(['1', '2', '3', '4', '5', '6']);

  // Update DOM based on current selection
  const updateSelectionUI = () => {
    photoCards.forEach(card => {
      const id = card.getAttribute('data-id');
      if (!id) return;

      const checkboxIndicator = card.querySelector('.checkbox-indicator');
      const checkIcon = checkboxIndicator?.querySelector('svg');

      if (selectedIds.has(id)) {
        // Selected style: orange thick border ring & high shadow depth
        card.classList.add('ring-4', 'ring-brand-orange', 'shadow-md');
        card.classList.remove('border-black/5');
        if (checkboxIndicator) {
          checkboxIndicator.classList.add('bg-brand-orange', 'border-brand-orange');
          checkboxIndicator.classList.remove('bg-black/40', 'border-white');
        }
        if (checkIcon) {
          checkIcon.classList.remove('opacity-0');
        }
      } else {
        // Deselected style: default light borders, dark semitransparent checkbox
        card.classList.remove('ring-4', 'ring-brand-orange', 'shadow-md');
        card.classList.add('border-black/5');
        if (checkboxIndicator) {
          checkboxIndicator.classList.remove('bg-brand-orange', 'border-brand-orange');
          checkboxIndicator.classList.add('bg-black/40', 'border-white');
        }
        if (checkIcon) {
          checkIcon.classList.add('opacity-0');
        }
      }
    });

    // Update Download Button Label
    if (downloadSelectedBtn) {
      downloadSelectedBtn.textContent = `Download ${selectedIds.size} Image${selectedIds.size === 1 ? '' : 's'}`;
      downloadSelectedBtn.disabled = selectedIds.size === 0;
      if (selectedIds.size === 0) {
        downloadSelectedBtn.classList.add('opacity-50', 'cursor-not-allowed');
        downloadSelectedBtn.classList.remove('hover:scale-[1.01]', 'hover:shadow-lg');
      } else {
        downloadSelectedBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        downloadSelectedBtn.classList.add('hover:scale-[1.01]', 'hover:shadow-lg');
      }
    }

    // Update Select All Checkbox/Button UI
    if (selectAllCheckbox && selectAllBtn) {
      if (selectedIds.size === photoCards.length) {
        selectAllCheckbox.classList.add('bg-brand-orange', 'border-brand-orange');
        selectAllCheckbox.innerHTML = '✓';
        selectAllBtn.innerHTML = `<span class="w-4 h-4 rounded border border-brand-orange flex items-center justify-center bg-brand-orange text-white text-[10px] select-none font-bold">✓</span> Deselect All`;
      } else {
        selectAllCheckbox.classList.remove('bg-brand-orange', 'border-brand-orange');
        selectAllCheckbox.innerHTML = '';
        selectAllBtn.innerHTML = `<span class="w-4 h-4 rounded border border-brand-orange/40 flex items-center justify-center bg-white text-white text-[10px] select-none"></span> Select All (${photoCards.length})`;
      }
    }
  };

  // Initialize selection UI
  updateSelectionUI();

  // Watch for file selections to generate preview
  if (fileInput && previewContainer && previewImage) {
    fileInput.addEventListener('change', (e: Event) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files[0]) {
        const file = target.files[0];

        // Size validation (Max 5MB = 5 * 1024 * 1024 bytes)
        const maxSizeBytes = 5 * 1024 * 1024;
        if (file.size > maxSizeBytes) {
          // Show error message
          if (sizeErrorMsg) {
            sizeErrorMsg.classList.remove('hidden');
            sizeErrorMsg.classList.add('flex');
          }
          
          // Clear input and previews
          fileInput.value = '';
          previewImage.src = '';
          previewContainer.classList.add('hidden');
          return;
        }

        // Hide error message if valid file is chosen
        if (sizeErrorMsg) {
          sizeErrorMsg.classList.add('hidden');
          sizeErrorMsg.classList.remove('flex');
        }

        const reader = new FileReader();

        reader.onload = (event) => {
          if (event.target && event.target.result) {
            previewImage.src = event.target.result as string;
            previewContainer.classList.remove('hidden');
          }
        };

        reader.readAsDataURL(file);
      }
    });
  }

  // Handle Change Photo overlay click
  if (changePhotoOverlay && fileInput) {
    changePhotoOverlay.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });
  }

  // Handle Drag & Drop styling
  if (dropZone) {
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropZone.classList.add('border-brand-blue', 'bg-brand-blue/5');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-brand-blue', 'bg-brand-blue/5');
      }, false);
    });
  }

  // Handle click on photo cards (toggles selection)
  photoCards.forEach(card => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-id');
      if (!id) return;

      if (selectedIds.has(id)) {
        selectedIds.delete(id);
      } else {
        selectedIds.add(id);
      }
      updateSelectionUI();
    });
  });

  // Handle Select All click (toggles between select-all and deselect-all)
  if (selectAllBtn) {
    selectAllBtn.addEventListener('click', () => {
      if (selectedIds.size === photoCards.length) {
        selectedIds.clear();
      } else {
        photoCards.forEach(card => {
          const id = card.getAttribute('data-id');
          if (id) selectedIds.add(id);
        });
      }
      updateSelectionUI();
    });
  }

  // Handle form submission to trigger simulated scanning flow
  if (form && scanningState && resultsState && matcherContainer && photoCodeInput) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const enteredCode = photoCodeInput.value.trim();
      if (!enteredCode) return;

      // Hide form
      form.classList.add('hidden');
      // Show scanning state
      if (scanningState) {
        scanningState.classList.remove('hidden');
        scanningState.classList.add('flex');
      }

      // After 2.5 seconds, transition to results
      setTimeout(() => {
        if (scanningState) {
          scanningState.classList.add('hidden');
          scanningState.classList.remove('flex');
        }
        resultsState.classList.remove('hidden');

        if (enteredCode.toUpperCase() === 'NOMATCH') {
          // No Matches Found Case
          if (searchedCodeLabel) searchedCodeLabel.textContent = enteredCode;
          if (noMatchesContainer) noMatchesContainer.classList.remove('hidden');
          if (matchesContainer) matchesContainer.classList.add('hidden');
          
          // Container keeps compact max-w-xl
          matcherContainer.classList.remove('max-w-4xl');
          matcherContainer.classList.add('max-w-xl');
        } else {
          // Match Found Case
          if (noMatchesContainer) noMatchesContainer.classList.add('hidden');
          if (matchesContainer) matchesContainer.classList.remove('hidden');
          
          // Pre-select all photos on new match success
          selectedIds = new Set<string>(['1', '2', '3', '4', '5', '6']);
          updateSelectionUI();

          // Container expands dynamically to max-w-4xl for comfortable widescreen grid viewing
          matcherContainer.classList.remove('max-w-xl');
          matcherContainer.classList.add('max-w-4xl');
        }
      }, 2500);
    });
  }

  // Handle search resets
  const resetSearch = () => {
    // Clear file inputs & previews
    if (fileInput) fileInput.value = '';
    if (previewImage) previewImage.src = '';
    if (previewContainer) previewContainer.classList.add('hidden');
    if (sizeErrorMsg) sizeErrorMsg.classList.add('hidden');
    if (form) form.reset();

    // Reset container size
    if (matcherContainer) {
      matcherContainer.classList.remove('max-w-4xl');
      matcherContainer.classList.add('max-w-xl');
    }

    // Hide results & scanning
    if (scanningState) {
      scanningState.classList.add('hidden');
      scanningState.classList.remove('flex');
    }
    if (resultsState) resultsState.classList.add('hidden');
    if (matchesContainer) matchesContainer.classList.add('hidden');
    if (noMatchesContainer) noMatchesContainer.classList.add('hidden');

    // Show form
    if (form) form.classList.remove('hidden');
  };

  if (resetMatchesBtn) resetMatchesBtn.addEventListener('click', resetSearch);
  if (resetNoMatchesBtn) resetNoMatchesBtn.addEventListener('click', resetSearch);
</script>
