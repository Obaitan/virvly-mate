---
import Button from './Button.astro';

interface Props {
  activePage?: 'home' | 'clients';
}

const { activePage = 'home' } = Astro.props;
---

<header 
  id="hdr" 
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-ease py-5 md:py-6 bg-transparent"
>
  <div class="wrap flex items-center justify-between">
    <!-- Brand Wordmark -->
    <a 
      href="/" 
      class="flex items-center hover:opacity-95 transition-opacity"
      aria-label="VirvlyMate Homepage"
    >
      <img 
        src="/brand/virvly-logo.svg" 
        alt="Virvly Logo" 
        class="h-7 md:h-8 w-auto logo-img transition-all duration-300 ease-ease mt-1"
      />
      <span class="font-heading font-extrabold text-xl tracking-tight transition-colors duration-300 logo-mate">Mate</span>
    </a>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3 md:gap-4">
      {activePage === 'home' ? (
        <>
          <a 
            href="/clients" 
            class="group inline-flex items-center gap-2 font-semibold text-[14px] md:text-[15px] text-white hover:text-brand-orange transition-colors py-2 px-1 focus:outline-none focus:underline nav-link-secondary"
            aria-label="Find my photos page"
          >
            <!-- Search Icon -->
            <svg 
              class="w-4 h-4 transition-transform duration-300 group-hover:scale-110" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2.5" 
              stroke-linecap="round"
            >
              <circle cx="11" cy="11" r="7"/>
              <path d="M20 20l-3.6-3.6"/>
            </svg>
            <span class="hidden sm:inline">Find my photos</span>
            <span class="sm:hidden">Find</span>
          </a>
          
          <Button 
            href="https://app.virvlymate.com" 
            variant="primary" 
            class="text-[13px] md:text-[14px] px-5 py-2.5 shadow-none hover:shadow-md hover:scale-[1.02]"
          >
            Try VirvlyMate
          </Button>
        </>
      ) : (
        <>
          <a 
            href="/" 
            class="font-semibold text-[14px] md:text-[15px] text-white hover:text-brand-orange transition-colors py-2 px-1 focus:outline-none focus:underline nav-link-secondary"
          >
            For Photographers
          </a>
          
          <Button 
            href="https://app.virvlymate.com" 
            variant="primary" 
            class="text-[13px] md:text-[14px] px-5 py-2.5 shadow-none hover:shadow-md hover:scale-[1.02]"
          >
            Try VirvlyMate
          </Button>
        </>
      )}
    </div>
  </div>
</header>

<style is:global>
  /* Header scroll transition standards */
  #hdr.scrolled {
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: 14px;
    padding-bottom: 14px;
  }

  /* Logo transitions */
  #hdr .logo-img {
    filter: brightness(0) invert(1);
  }

  #hdr .logo-mate {
    color: #FFFFFF;
  }

  #hdr.scrolled .logo-img {
    filter: none;
  }

  #hdr.scrolled .logo-mate {
    color: #F78C1E;
  }

  #hdr.scrolled .nav-link-secondary {
    color: #4A4A4A !important;
  }

  #hdr.scrolled .nav-link-secondary:hover {
    color: #F78C1E !important;
  }
</style>

<script>
  // Handle passive scroll interaction for the header background
  const header = document.getElementById('hdr');
  if (header) {
    const handleScroll = () => {
      if (window.scrollY > 40) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    };

    // Add passive event listener for performance
    window.addEventListener('scroll', handleScroll, { passive: true });
    // Run once on load to ensure state correctness
    handleScroll();
  }
</script>
